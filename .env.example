# Copy to .env and adjust. Compose uses these defaults except values marked required.
# Required: Enable Banking application ID and matching <ID>.pem at the repository root.
ENABLE_BANKING_PEM_NAME=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable-banking.pem
ENABLE_BANKING_REDIRECT_URL=https://banking.miquelgc.net/enablebanking/callback
ENABLE_BANKING_BACKEND_URL=http://localhost:4000
TZ=Europe/Madrid

# Database
MYSQL_ROOT_PASSWORD=HoneyHold-root
MYSQL_DATABASE=finance
MYSQL_USER=finance
MYSQL_PASSWORD=finance-pw

# Shared secret required by POST /api/ingest (automation entry point)
INGEST_TOKEN=dev-ingest-token

# Backups: cron expression + days of dumps to keep in ./backups
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=14
